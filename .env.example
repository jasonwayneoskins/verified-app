# --- Mode ---
# Leave SUPABASE_URL empty to run in local DEMO mode (SQLite file, no accounts needed).
# Set the Supabase vars to run in PRODUCTION mode (Supabase Postgres + Supabase Auth).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase project settings -> Database -> Connection string, URI).
# Used for all data access in production mode. Keep secret.
DATABASE_URL=

# --- Whop subscription gating ---
# Server-only. Sellers need an ACTIVE $39/mo "Verified" Whop membership to use
# the dashboard and log picks. Public pages stay open to everyone.
WHOP_API_KEY=
WHOP_PRODUCT_ID=
# Optional: your Whop company id (biz_...). The Whop API requires account_id
# when calling with an API key; include it if membership lookups fail.
WHOP_COMPANY_ID=
# Link buyers click to subscribe (set once the Whop product is purchasable).
WHOP_CHECKOUT_URL=
# How long a successful verification is cached before re-checking Whop.
WHOP_CACHE_HOURS=6

# --- App ---
PORT=3000
# Long random string. Used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Long random string. Protects the grading cron endpoint: /api/cron/grade?secret=...
CRON_SECRET=change-me-to-another-long-random-string
# Public base URL of the deployed app, e.g. https://verified.yourdomain.com (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
# App brand shown on badges/pages
APP_NAME=Verified
