# --- Mode ---
# Leave SUPABASE_URL empty to run in local DEMO mode (SQLite file, no accounts needed).
# Set the Supabase vars to run in PRODUCTION mode (Supabase Postgres + Supabase Auth).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase project settings -> Database -> Connection string, URI).
# Used for all data access in production mode. Keep secret.
DATABASE_URL=

# --- App ---
PORT=3000
# Long random string. Used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Long random string. Protects the grading cron endpoint: /api/cron/grade?secret=...
CRON_SECRET=change-me-to-another-long-random-string
# Public base URL of the deployed app, e.g. https://verified.yourdomain.com (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
# App brand shown on badges/pages
APP_NAME=Verified
